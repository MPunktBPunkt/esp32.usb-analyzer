{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MPunktBPunkt/esp32.usb-analyzer/schemas/capture_event.v1.schema.json",
  "title": "capture_event.v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "version",
    "session_id",
    "node_id",
    "seq",
    "timestamp_us",
    "timestamp_domain",
    "role",
    "event_type",
    "status"
  ],
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "session_id": { "type": "string" },
    "node_id": { "type": "string" },
    "seq": { "type": "integer", "minimum": 0 },
    "timestamp_us": { "type": "integer", "minimum": 0 },
    "timestamp_domain": {
      "type": "string",
      "enum": ["local", "session", "wall"]
    },
    "role": {
      "type": "string",
      "enum": ["host", "device", "unassigned", "controller"]
    },
    "fw_sha": { "type": "string" },
    "direction": {
      "type": "string",
      "enum": [
        "host_to_device",
        "device_to_host",
        "bidirectional",
        "none"
      ]
    },
    "endpoint": { "type": "integer", "minimum": 0, "maximum": 15 },
    "transfer_type": {
      "type": "string",
      "enum": ["control", "bulk", "interrupt", "isochronous", "none"]
    },
    "event_type": { "type": "string" },
    "length": { "type": "integer", "minimum": 0 },
    "status": { "type": "string" },
    "usb_state": { "type": "string" },
    "payload": {
      "type": ["string", "null"],
      "description": "Optional hex or base64; null when omitted"
    },
    "decoded": {
      "type": ["object", "null"],
      "properties": {
        "protocol": { "type": "string" },
        "command": { "type": "string" },
        "lba": { "type": "integer" },
        "transfer_length": { "type": "integer" },
        "tag": { "type": "integer" },
        "residue": { "type": "integer" },
        "csw_status": { "type": "integer" },
        "cdb_hex": { "type": "string" }
      }
    }
  }
}
